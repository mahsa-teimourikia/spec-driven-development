{
  "version": 1,
  "id": "enterprise-agentic-pdlc-control-loop",
  "title": "Enterprise Agentic PDLC control loop",
  "purpose": "Show how inherited enterprise constraints shape a bounded agentic delivery loop and how runtime evidence feeds the next specification revision.",
  "output": {
    "svg": "agentic-pdlc-control-loop.svg",
    "medium": "course notebook and documentation",
    "alt_text": "Two-layer diagram. Organization, platform, domain, project, feature, and implementation constraints inherit left to right into a delivery loop: change intent, clarify and specify, technical plan, work graph, bounded agents, verification, human and automated gates, deployment and observation, then feedback to the specification."
