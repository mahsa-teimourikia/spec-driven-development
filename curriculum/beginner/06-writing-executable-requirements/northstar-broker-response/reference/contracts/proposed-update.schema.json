{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/northstar/ai-2219/proposed-update.schema.json",
  "title": "ProposedUpdate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "submission_id",
    "submission_revision",
    "requirement_context_digest",
    "field",
    "proposed_value",
    "source_response_id",
    "source_span",
    "requirement_id",
    "model_version",
    "evidence_ids",
    "status"
  ],
  "properties": {
    "proposal_id": {"type": "string", "minLength": 1},
    "submission_id": {"type": "string", "minLength": 1},
    "submission_revision": {"type": "string", "minLength": 1},
    "requirement_context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "field": {"type": "string", "enum": ["construction_year", "occupancy", "building_value"]},
    "proposed_value": {},
    "source_response_id": {"type": "string", "minLength": 1},
    "source_span": {"type": "string", "minLength": 1},
    "requirement_id": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"type": "string", "enum": ["extracted", "validated", "conflicting", "mapping_ambiguous", "source_conflict", "attachment_review_required", "unmapped", "awaiting_review", "approved", "rejected", "applied", "stale"]}
  }
}
