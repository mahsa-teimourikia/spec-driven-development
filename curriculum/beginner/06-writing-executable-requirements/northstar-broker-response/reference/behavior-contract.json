    },
    {
      "id": "REQ-BR-004", "revision": "1", "status": "approved", "role": "normative_requirement", "ears_pattern": "state_driven", "capability": "overwrite_verified_value", "owner": "underwriting_domain", "source_ids": ["SRC-BR-DECISIONS"],
