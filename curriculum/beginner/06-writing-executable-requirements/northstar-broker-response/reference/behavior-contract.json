      "id": "REQ-BR-001", "revision": "1", "status": "approved", "role": "normative_requirement", "ears_pattern": "ubiquitous", "capability": "overwrite_verified_value", "owner": "underwriting_domain", "source_ids": ["SRC-BR-DECISIONS"],
