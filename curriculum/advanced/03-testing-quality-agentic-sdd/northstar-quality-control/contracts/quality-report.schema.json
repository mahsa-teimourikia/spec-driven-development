{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.example/schemas/quality-report.json",
  "title": "Specification-traceable quality report",
  "type": "object",
  "required": [
    "report_id",
    "change_id",
    "revision",
    "specification_revision",
    "policy_version",
    "decision",
    "findings",
    "evidence_ids",
    "coverage",
    "metrics",
    "limitations",
    "release_authorized",
    "merge_authorized",
    "deployment_authorized",
    "activation_authorized",
    "delivery_state"
  ],
  "properties": {
    "report_id": {"type": "string", "pattern": "^QUALITY-REPORT-[A-F0-9]{16}$"},
    "decision": {
      "enum": [
        "CONFORMANT",
        "BLOCKED",
        "INSUFFICIENT_EVIDENCE",
        "REVIEW_REQUIRED",
        "STALE_EVIDENCE",
        "CONFORMANT_WITH_EXCEPTION"
      ]
    },
    "release_authorized": {"const": false},
    "merge_authorized": {"const": false},
    "deployment_authorized": {"const": false},
    "activation_authorized": {"const": false},
    "delivery_state": {"const": "READY_FOR_INTEGRATION_REVIEW"},
    "findings": {"type": "array", "items": {"type": "object"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "coverage": {"type": "object"},
    "metrics": {"type": "object"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
