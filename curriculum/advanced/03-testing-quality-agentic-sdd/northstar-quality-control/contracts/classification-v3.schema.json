{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.example/contracts/classification-v3.schema.json",
  "title": "Northstar classification proposal v3",
  "type": "object",
  "required": ["document_id", "tenant_id", "document_type", "confidence", "ambiguous", "evidence_refs", "model_revision"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "document_type": {"enum": ["APPLICATION", "LOSS_HISTORY", "POLICY", "OTHER"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "ambiguous": {"type": "boolean"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "model_revision": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
