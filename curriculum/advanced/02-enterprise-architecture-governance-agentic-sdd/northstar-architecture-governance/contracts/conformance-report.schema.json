{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.example/schemas/architecture-conformance-report.json",
  "title": "Architecture conformance report",
  "type": "object",
  "required": [
    "report_id",
    "repository",
    "base_commit",
    "head_commit",
    "environment",
    "policy_version",
    "decision",
    "findings",
    "evidence_ids",
    "scanner_coverage",
    "unresolved_dependency_categories",
    "limitations"
  ],
  "properties": {
    "report_id": {"type": "string", "pattern": "^ARCH-REPORT-[A-F0-9]{16}$"},
    "repository": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "head_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "environment": {"enum": ["development", "test", "staging", "production"]},
    "policy_version": {"type": "string", "minLength": 1},
    "decision": {
      "enum": ["CONFORMANT", "CONFORMANT_WITH_EXCEPTION", "BLOCKED", "REVIEW_REQUIRED", "INSUFFICIENT_EVIDENCE", "REASSESSMENT_REQUIRED"]
    },
    "findings": {"type": "array", "items": {"type": "object"}},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "scanner_coverage": {
      "type": "object",
      "required": ["source_basis", "python_files_parsed", "transitive_dependencies"]
    },
    "unresolved_dependency_categories": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
