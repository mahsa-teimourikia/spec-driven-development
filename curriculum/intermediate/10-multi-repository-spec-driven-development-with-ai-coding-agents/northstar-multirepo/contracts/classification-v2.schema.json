{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:contract:classification:2",
  "title": "DocumentClassificationProposalV2",
  "type": "object",
  "required": ["proposal_id", "document_id", "tenant_id", "candidate_requirement_ids", "ambiguity_status", "model_confidence", "review_required", "evidence_refs", "model_provenance"],
  "properties": {
    "proposal_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "candidate_requirement_ids": {"type": "array", "items": {"type": "string"}},
    "ambiguity_status": {"enum": ["SUPPORTED", "AMBIGUOUS", "UNSUPPORTED"]},
    "model_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "review_required": {"type": "boolean"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "model_provenance": {
      "type": "object",
      "required": ["model_id", "model_revision"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
