{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.example/contracts/classification-v3.schema.json",
  "title": "Classification proposal revision 3",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "tenant_id", "document_id", "ambiguity_status", "review_required", "evidence_refs", "model_revision", "producer_run_id"],
  "properties": {
    "proposal_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "ambiguity_status": {"enum": ["SUPPORTED", "AMBIGUOUS", "UNSUPPORTED"]},
    "review_required": {"type": "boolean"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "model_revision": {"type": "string", "minLength": 1},
    "producer_run_id": {"type": "string", "minLength": 1}
  }
}
