{
  "version": 2,
  "resolution": "longest_normalized_prefix_then_precedence",
  "rules": [
    {"prefix": "specifications/", "scope": "intent", "role": "domain_owner", "resource": "REQ-DOC-2500-01", "decision": "approve_requirement_revision", "precedence": 100},
    {"prefix": "contracts/", "scope": "contract", "role": "contract_owner", "resource": "CONTRACT-CLASSIFICATION-001", "decision": "approve_contract_revision", "precedence": 100},
    {"prefix": "tests/protected/", "scope": "acceptance_oracle", "role": "quality_owner", "resource": "AC-DOC-2500-02", "decision": "approve_acceptance_oracle", "precedence": 200},
    {"prefix": "src/authorization.py", "scope": "security", "role": "security_owner", "resource": "SECURITY-AUTHORIZATION", "decision": "approve_security_change", "precedence": 300},
    {"prefix": "src/", "scope": "implementation", "role": "engineering_reviewer", "resource": "repository:ai-service", "decision": "approve_implementation", "precedence": 10},
    {"prefix": "tests/", "scope": "implementation", "role": "engineering_reviewer", "resource": "repository:ai-service", "decision": "approve_implementation", "precedence": 10}
  ],
  "separation_of_duties": {"author_cannot_approve_own_change": true, "github_review_is_not_deployment_approval": true}
}
